<UserControl x:Class="Jejak.App.Views.Dialogs.KonfirmasiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Jejak.App.Controls">
    <StackPanel>
        <TextBlock Margin="28,16,28,0" FontSize="14" LineHeight="22" Text="{Binding Pesan}" TextWrapping="Wrap" />
        <Border Margin="0,22,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Margin="28,16,28,22" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding BatalCommand}" Content="Batal" Style="{StaticResource Btn.Secondary}" />
                <Button x:Name="TombolYa" Margin="10,0,0,0" Command="{Binding YaCommand}" Content="{Binding TombolYa}" IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bahaya}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
