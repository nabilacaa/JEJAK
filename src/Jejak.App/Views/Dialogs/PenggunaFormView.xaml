<UserControl x:Class="Jejak.App.Views.Dialogs.PenggunaFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Jejak.App.Controls">
    <StackPanel>
        <StackPanel Margin="28,22,28,0">
            <TextBlock Style="{StaticResource Text.Label}"><Run Text="Username" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
            <TextBox c:Hint.HasError="{Binding UsernameGalat, Converter={StaticResource AdaKeBool}}" c:Hint.Icon="{StaticResource Icon.User}" c:Hint.Text="huruf kecil, mis. nama.pemandu" Style="{StaticResource Input}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Lower" MaxLength="50" />
            <TextBlock Style="{StaticResource Text.Error}" Text="{Binding UsernameGalat}" Visibility="{Binding UsernameGalat, Converter={StaticResource AdaKeVisibility}}" />
            <Border Height="18" />
            <TextBlock Style="{StaticResource Text.Label}"><Run Text="Nama lengkap" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
            <TextBox c:Hint.HasError="{Binding NamaGalat, Converter={StaticResource AdaKeBool}}" c:Hint.Text="Nama yang tampil di aplikasi" Style="{StaticResource Input}" Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            <TextBlock Style="{StaticResource Text.Error}" Text="{Binding NamaGalat}" Visibility="{Binding NamaGalat, Converter={StaticResource AdaKeVisibility}}" />
            <Border Height="18" />
            <TextBlock Style="{StaticResource Text.Label}"><Run Text="Peran" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
            <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding PeranOpsi}" SelectedItem="{Binding PeranDipilih}" IsEnabled="{Binding BisaUbahPeran}" />
            <Border Height="18" />
            <TextBlock Style="{StaticResource Text.Label}" Text="{Binding LabelPassword}" />
            <PasswordBox c:Hint.HasError="{Binding PasswordGalat, Converter={StaticResource AdaKeBool}}" c:Hint.Icon="{StaticResource Icon.Lock}" c:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay}" Style="{StaticResource Input.Password}" />
            <TextBlock Style="{StaticResource Text.Error}" Text="{Binding PasswordGalat}" Visibility="{Binding PasswordGalat, Converter={StaticResource AdaKeVisibility}}" />
            <Border Margin="0,18,0,0" Padding="16,12" Background="{DynamicResource Brush.Surface2}" CornerRadius="10">
                <Grid>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Akun aktif" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="Akun nonaktif tidak dapat login." />
                    </StackPanel>
                    <CheckBox HorizontalAlignment="Right" IsChecked="{Binding Aktif}" IsEnabled="{Binding BisaUbahPeran}" Style="{StaticResource Toggle}" />
                </Grid>
            </Border>
        </StackPanel>
        <Border Margin="28,14,28,0" Padding="12,10" Background="{DynamicResource Brush.DangerBg}" CornerRadius="10" Visibility="{Binding GalatUmum, Converter={StaticResource AdaKeVisibility}}">
            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.Danger}" Text="{Binding GalatUmum}" TextWrapping="Wrap" />
        </Border>
        <Border Margin="0,22,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Margin="28,16,28,22" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding BatalCommand}" Content="Batal" Style="{StaticResource Btn.Secondary}" />
                <Button Margin="10,0,0,0" Command="{Binding SimpanCommand}" Content="Simpan Akun" IsDefault="True" IsEnabled="{Binding SedangMenyimpan, Converter={StaticResource BoolBalik}}" Style="{StaticResource Btn.Primary}" Tag="{StaticResource Icon.Save}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
