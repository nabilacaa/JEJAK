<UserControl x:Class="Jejak.App.Views.Dialogs.PenugasanFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Jejak.App.Controls">
    <StackPanel>
        <StackPanel Margin="28,22,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}"><Run Text="Kode" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
                    <TextBox c:Hint.HasError="{Binding KodeGalat, Converter={StaticResource AdaKeBool}}" c:Hint.Text="mis. P9" Style="{StaticResource Input}" Text="{Binding Kode, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="10" />
                    <TextBlock Style="{StaticResource Text.Error}" Text="{Binding KodeGalat}" Visibility="{Binding KodeGalat, Converter={StaticResource AdaKeVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Label}"><Run Text="Kategori" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
                    <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding KategoriOpsi}" SelectedItem="{Binding KategoriDipilih}" />
                </StackPanel>
            </Grid>
            <Border Height="18" />
            <TextBlock Style="{StaticResource Text.Label}"><Run Text="Judul" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
            <TextBox c:Hint.HasError="{Binding JudulGalat, Converter={StaticResource AdaKeBool}}" c:Hint.Text="mis. Esai Refleksi Akhir" Style="{StaticResource Input}" Text="{Binding JudulPenugasan, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
            <TextBlock Style="{StaticResource Text.Error}" Text="{Binding JudulGalat}" Visibility="{Binding JudulGalat, Converter={StaticResource AdaKeVisibility}}" />
            <Border Height="18" />
            <TextBlock Style="{StaticResource Text.Label}" Text="Deskripsi (opsional)" />
            <TextBox c:Hint.Text="Ringkasan instruksi penugasan" MaxLength="300" Style="{StaticResource Input.Multi}" Text="{Binding Deskripsi, UpdateSourceTrigger=PropertyChanged}" />
            <Border Height="18" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}"><Run Text="Tanggal mulai" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
                    <DatePicker SelectedDate="{Binding TanggalMulai}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Label}"><Run Text="Tenggat" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
                    <DatePicker c:Hint.HasError="{Binding TenggatGalat, Converter={StaticResource AdaKeBool}}" SelectedDate="{Binding TanggalTenggat}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Jam" />
                    <TextBox c:Hint.HasError="{Binding TenggatGalat, Converter={StaticResource AdaKeBool}}" c:Hint.Text="23:59" MaxLength="5" Style="{StaticResource Input}" Text="{Binding JamTenggat, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Text.Error}" Text="{Binding TenggatGalat}" Visibility="{Binding TenggatGalat, Converter={StaticResource AdaKeVisibility}}" />
            <Border Height="18" />
            <TextBlock Style="{StaticResource Text.Label}"><Run Text="Bobot (1–100)" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
            <TextBox c:Hint.HasError="{Binding BobotGalat, Converter={StaticResource AdaKeBool}}" c:Hint.Text="mis. 10" Style="{StaticResource Input}" Text="{Binding BobotTeks, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" />
            <TextBlock Style="{StaticResource Text.Error}" Text="{Binding BobotGalat}" Visibility="{Binding BobotGalat, Converter={StaticResource AdaKeVisibility}}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Faint}" Text="Bobot dipakai pada nilai akhir berbobot (BR-04)." />
        </StackPanel>
        <Border Margin="28,14,28,0" Padding="12,10" Background="{DynamicResource Brush.DangerBg}" CornerRadius="10" Visibility="{Binding GalatUmum, Converter={StaticResource AdaKeVisibility}}">
            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.Danger}" Text="{Binding GalatUmum}" TextWrapping="Wrap" />
        </Border>
        <Border Margin="0,22,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Margin="28,16,28,22" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding BatalCommand}" Content="Batal" Style="{StaticResource Btn.Secondary}" />
                <Button Margin="10,0,0,0" Command="{Binding SimpanCommand}" Content="Simpan Penugasan" IsDefault="True" IsEnabled="{Binding SedangMenyimpan, Converter={StaticResource BoolBalik}}" Style="{StaticResource Btn.Primary}" Tag="{StaticResource Icon.Save}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
