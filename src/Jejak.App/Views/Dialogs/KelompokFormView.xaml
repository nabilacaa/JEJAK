<UserControl x:Class="Jejak.App.Views.Dialogs.KelompokFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Jejak.App.Controls">
    <StackPanel>
        <StackPanel Margin="28,22,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}"><Run Text="Nomor" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
                    <TextBox c:Hint.HasError="{Binding NomorGalat, Converter={StaticResource AdaKeBool}}" c:Hint.Text="mis. 13" Style="{StaticResource Input}" Text="{Binding NomorTeks, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" />
                    <TextBlock Style="{StaticResource Text.Error}" Text="{Binding NomorGalat}" Visibility="{Binding NomorGalat, Converter={StaticResource AdaKeVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Text.Label}"><Run Text="Nama kelompok" /><Run Foreground="{DynamicResource Brush.Danger}" Text=" *" /></TextBlock>
                    <TextBox c:Hint.HasError="{Binding NamaGalat, Converter={StaticResource AdaKeBool}}" c:Hint.Text="mis. Nawasena" Style="{StaticResource Input}" Text="{Binding Nama, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                    <TextBlock Style="{StaticResource Text.Error}" Text="{Binding NamaGalat}" Visibility="{Binding NamaGalat, Converter={StaticResource AdaKeVisibility}}" />
                </StackPanel>
            </Grid>
            <Border Height="18" />
            <TextBlock Style="{StaticResource Text.Label}" Text="Deskripsi (opsional)" />
            <TextBox c:Hint.Text="Makna nama kelompok atau catatan lain" MaxLength="200" Style="{StaticResource Input.Multi}" Text="{Binding Deskripsi, UpdateSourceTrigger=PropertyChanged}" />
            <Border Height="18" />
            <TextBlock Style="{StaticResource Text.Label}"><Run Text="Pemandu" /></TextBlock>
            <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding PemanduOpsi}" SelectedItem="{Binding PemanduDipilih}" />
            <TextBlock Style="{StaticResource Text.Error}" Text="{Binding PemanduGalat}" Visibility="{Binding PemanduGalat, Converter={StaticResource AdaKeVisibility}}" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Faint}" Text="Hanya pemandu aktif yang belum membimbing kelompok lain yang ditampilkan." TextWrapping="Wrap" />
        </StackPanel>
        <Border Margin="28,14,28,0" Padding="12,10" Background="{DynamicResource Brush.DangerBg}" CornerRadius="10" Visibility="{Binding GalatUmum, Converter={StaticResource AdaKeVisibility}}">
            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.Danger}" Text="{Binding GalatUmum}" TextWrapping="Wrap" />
        </Border>
        <Border Margin="0,22,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <StackPanel Margin="28,16,28,22" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding BatalCommand}" Content="Batal" Style="{StaticResource Btn.Secondary}" />
                <Button Margin="10,0,0,0" Command="{Binding SimpanCommand}" Content="Simpan Kelompok" IsDefault="True" IsEnabled="{Binding SedangMenyimpan, Converter={StaticResource BoolBalik}}" Style="{StaticResource Btn.Primary}" Tag="{StaticResource Icon.Save}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
