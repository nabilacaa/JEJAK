<UserControl x:Class="Jejak.App.Views.Pages.KaderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Jejak.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding KembaliCommand}" Content="{Binding TeksKembali}" Style="{StaticResource Btn.Link}" Tag="{StaticResource Icon.ChevronLeft}" />
            <Button HorizontalAlignment="Right" Command="{Binding UbahCommand}" Content="Ubah Data" Style="{StaticResource Btn.Secondary}" Tag="{StaticResource Icon.Edit}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolKeVisibility}}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Profil  -->
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ContentControl Width="76" Height="76" Margin="0,8,0,0" HorizontalAlignment="Center" Content="{Binding Nama}" FontSize="26" Style="{StaticResource Avatar}" />
                        <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="19" FontWeight="Bold" Text="{Binding Nama}" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Sub}" Text="{Binding NrpAngkatan}" />
                        <c:Badge Margin="0,12,0,0" HorizontalAlignment="Center" Kind="{Binding StatusKind}" Text="{Binding Status}" />

                        <Border Margin="0,20" Style="{StaticResource Pemisah}" />
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Text="{Binding KetuntasanTeks}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KetuntasanBahaya}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Ketuntasan" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Text="{Binding NilaiTeks}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NilaiBahaya}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Nilai akhir" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Text="{Binding TerlambatTeks}" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Terlambat" />
                            </StackPanel>
                        </UniformGrid>
                        <Border Margin="0,20" Style="{StaticResource Pemisah}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Kelompok" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Kelompok}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Text.Caption}" Text="Pemandu" />
                            <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Pemandu}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Text.Caption}" Text="Kontak" />
                            <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Kontak}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource Text.Caption}" Text="Terdaftar" />
                            <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Terdaftar}" />
                        </Grid>

                        <!--  Alasan berisiko (BR-05)  -->
                        <Border Margin="0,16,0,0" Padding="14,12" Background="{DynamicResource Brush.DangerBg}" CornerRadius="10" Visibility="{Binding Alasan.Count, Converter={StaticResource AdaKeVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Margin="0,0,8,0" Data="{StaticResource Icon.Alert}" Foreground="{DynamicResource Brush.Danger}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Danger}" Text="Alasan ditandai berisiko" />
                                </StackPanel>
                                <ItemsControl Margin="26,8,0,0" Focusable="False" ItemsSource="{Binding Alasan}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Brush.Danger}" Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Tren nilai  -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.CardTitle}" Text="Tren Nilai per Penugasan" />
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" Text="Penugasan jatuh tempo · nilai 0 = tidak dikumpulkan" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                                <Border Width="16" Height="3" Margin="0,0,6,0" Background="{DynamicResource Brush.Accent}" CornerRadius="1.5" />
                                <TextBlock Margin="0,0,16,0" Style="{StaticResource Text.Caption}" Text="{Binding LabelSeri}" />
                                <Border Width="16" Height="2" Margin="0,0,6,0" Background="{DynamicResource Brush.Faint}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Rata-rata kelompok" />
                            </StackPanel>
                        </Grid>
                        <c:LineChart Margin="0,14,0,0"
                                     GridBrush="{DynamicResource Brush.Grid}"
                                     Items="{Binding Grafik}"
                                     KosongText="Belum ada penugasan yang jatuh tempo."
                                     MutedBrush="{DynamicResource Brush.Muted}"
                                     Pembanding="{Binding Pembanding}"
                                     PembandingBrush="{DynamicResource Brush.Faint}"
                                     SeriesBrush="{DynamicResource Brush.Accent}"
                                     SurfaceBrush="{DynamicResource Brush.Surface}"
                                     TextBrush="{DynamicResource Brush.Text}"
                                     WarnBrush="{DynamicResource Brush.Danger}" />
                    </DockPanel>
                </Border>

                <!--  Linimasa jejak penugasan (FR-17)  -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel Margin="0,0,0,16" DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Jejak Penugasan" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Caption}" Text="{Binding SubJejak}" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl Focusable="False" ItemsSource="{Binding Jejak}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="58">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="2" Margin="0,0,0,0" HorizontalAlignment="Center" Background="{DynamicResource Brush.Border}" />
                                            <Border x:Name="titik" Width="18" Height="18" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Faint}" BorderThickness="2.5" CornerRadius="9" />
                                            <StackPanel Grid.Column="1" Margin="10,2,12,14">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Judul}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Keterangan}" />
                                                    <!--  FR-39: tautan hasil tugas  -->
                                                    <Button Margin="12,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.BukaTautanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Tautan}"
                                                            Style="{StaticResource Btn.Link}"
                                                            ToolTip="{Binding Tautan}"
                                                            Visibility="{Binding Tautan, Converter={StaticResource AdaKeVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="Buka tugas" />
                                                            <c:Icon Width="13" Height="13" Margin="4,0,0,0" Data="{StaticResource Icon.External}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                            <c:Badge Grid.Column="2" Margin="0,2,0,0" VerticalAlignment="Top" Kind="{Binding StatusKind}" Text="{Binding StatusTeks}" />
                                            <TextBlock x:Name="nilai" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="18" FontWeight="Bold" Text="{Binding NilaiTeks}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NilaiBahaya}" Value="True">
                                                <Setter TargetName="nilai" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                <Setter TargetName="titik" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                                <Setter TargetName="titik" Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                                <Setter TargetName="titik" Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Info">
                                                <Setter TargetName="titik" Property="BorderBrush" Value="{DynamicResource Brush.Info}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
