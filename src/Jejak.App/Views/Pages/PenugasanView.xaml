<UserControl x:Class="Jejak.App.Views.Pages.PenugasanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Jejak.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--  Tab status  -->
            <Border Padding="4" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="TabPenugasan" IsChecked="{Binding TabSemua}" Style="{StaticResource Tab}">
                        <TextBlock><Run Text="Semua  " /><Run Foreground="{DynamicResource Brush.Muted}" Text="{Binding JumlahSemua, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton GroupName="TabPenugasan" IsChecked="{Binding TabBerjalan}" Style="{StaticResource Tab}">
                        <TextBlock><Run Text="Berjalan  " /><Run Foreground="{DynamicResource Brush.Muted}" Text="{Binding JumlahBerjalan, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton GroupName="TabPenugasan" IsChecked="{Binding TabSelesai}" Style="{StaticResource Tab}">
                        <TextBlock><Run Text="Selesai  " /><Run Foreground="{DynamicResource Brush.Muted}" Text="{Binding JumlahSelesai, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton GroupName="TabPenugasan" IsChecked="{Binding TabBelum}" Style="{StaticResource Tab}">
                        <TextBlock><Run Text="Belum Dimulai  " /><Run Foreground="{DynamicResource Brush.Muted}" Text="{Binding JumlahBelum, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                </StackPanel>
            </Border>
            <TextBox Grid.Column="2" c:Hint.Icon="{StaticResource Icon.Search}" c:Hint.Text="Cari judul atau kode…" Style="{StaticResource Input}" Text="{Binding Cari, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <Button Grid.Column="3" Margin="12,0,0,0" Command="{Binding TambahCommand}" Content="Tambah Penugasan" Style="{StaticResource Btn.Primary}" Tag="{StaticResource Icon.Plus}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolKeVisibility}}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card.Flush}">
            <DataGrid Margin="8,0" ItemsSource="{Binding Tampil}" RowHeight="62">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="56" Header="ID">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock FontWeight="Bold" Foreground="{DynamicResource Brush.AccentText}" Text="{Binding Data.Kode}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*" MinWidth="200" Header="PENUGASAN">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Data.Judul}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Data.Deskripsi}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="132" Header="KATEGORI">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><c:Badge Kind="{Binding KategoriKind}" Text="{Binding Data.Kategori}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="80" Binding="{Binding Mulai}" ElementStyle="{StaticResource Text.Cell.Muted}" Header="MULAI" />
                    <DataGridTextColumn Width="120" Binding="{Binding Tenggat}" ElementStyle="{StaticResource Text.Cell.Muted}" Header="TENGGAT" />
                    <DataGridTextColumn Width="64" Binding="{Binding Data.Bobot, StringFormat='{}{0}%'}" ElementStyle="{StaticResource Text.Cell.Bold}" Header="BOBOT" />
                    <DataGridTemplateColumn Width="140" Header="STATUS" HeaderStyle="{StaticResource Header.Tengah}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><c:Badge HorizontalAlignment="Center" Kind="{Binding StatusKind}" Text="{Binding StatusTeks}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="180" Header="PENGUMPULAN">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding AdaPengumpulan, Converter={StaticResource BoolKeVisibility}}">
                                        <ProgressBar x:Name="bar" Width="86" VerticalAlignment="Center" Value="{Binding Data.PersenKumpul, Mode=OneWay}" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="{Binding KumpulTeks}" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource Brush.Faint}" Text="—" Visibility="{Binding AdaPengumpulan, Converter={StaticResource BoolKeVisibility}, ConverterParameter=balik}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding KumpulRendah}" Value="True">
                                        <Setter TargetName="bar" Property="Foreground" Value="{DynamicResource Brush.BarWarn}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="112" Header="AKSI" HeaderStyle="{StaticResource Header.Kanan}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.NilaiCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" IsEnabled="{Binding AdaPengumpulan}" Style="{StaticResource Btn.Icon}" Tag="{StaticResource Icon.Check}" ToolTip="Buka penilaian" />
                                    <Button Command="{Binding DataContext.UbahCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource Btn.Icon}" Tag="{StaticResource Icon.Edit}" ToolTip="Ubah" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolKeVisibility}}" />
                                    <Button Command="{Binding DataContext.HapusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource Btn.Icon.Danger}" Tag="{StaticResource Icon.Trash}" ToolTip="Hapus" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolKeVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
