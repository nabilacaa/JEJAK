<Window x:Class="Jejak.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Jejak.App.Controls"
        Title="JEJAK — Jurnal Evaluasi dan Jejak Aktivitas Kader"
        Width="1440"
        Height="900"
        MinWidth="1280"
        MinHeight="720"
        Icon="/Assets/jejak.ico"
        Style="{StaticResource Window.Base}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ Sidebar ============  -->
        <Border Background="{DynamicResource Brush.Side}">
            <DockPanel>
                <StackPanel Margin="24,22,24,0" DockPanel.Dock="Top">
                    <c:Logo />
                    <Border Margin="-8,22,-8,0" Padding="14,10" Background="{DynamicResource Brush.Side2}" CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Margin="0,0,12,0" Data="{StaticResource Icon.Calendar}" Foreground="{DynamicResource Brush.SideMuted}" />
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SideText}" Text="{Binding NamaProgram}" />
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.SideMuted}" Text="{Binding PeriodeProgram}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Pengguna + logout  -->
                <Border Margin="16,0" Padding="8,16" BorderBrush="{DynamicResource Brush.SideBorder}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Width="36" Height="36" Content="{Binding NamaPengguna}" Style="{StaticResource Avatar}" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SideText}" Text="{Binding NamaPengguna}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource Brush.SideMuted}" Text="{Binding LabelPeran}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Command="{Binding KeluarCommand}"
                                Foreground="{DynamicResource Brush.SideMuted}"
                                Style="{StaticResource Btn.Icon}"
                                Tag="{StaticResource Icon.Logout}"
                                ToolTip="Keluar" />
                    </Grid>
                </Border>

                <ScrollViewer Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0">
                        <StackPanel.Resources>
                            <DataTemplate x:Key="ItemMenu">
                                <Button Margin="0,0,0,4"
                                        Command="{Binding DataContext.NavigasiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Kunci}"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Height="40" Padding="14,0" Background="Transparent" CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <c:Icon x:Name="ikon"
                                                            VerticalAlignment="Center"
                                                            Data="{Binding Ikon, Converter={StaticResource KeResource}}"
                                                            Foreground="{DynamicResource Brush.SideMuted}" />
                                                    <TextBlock x:Name="label"
                                                               Grid.Column="1"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource Brush.SideText}"
                                                               Text="{Binding Label}" />
                                                    <Border x:Name="lencana"
                                                            Grid.Column="2"
                                                            MinWidth="24"
                                                            Height="20"
                                                            Padding="6,0"
                                                            Background="{DynamicResource Brush.Badge}"
                                                            CornerRadius="10"
                                                            Visibility="{Binding Badge, Converter={StaticResource AdaKeVisibility}}">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="White" Text="{Binding Badge}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Side2}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Aktif}" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    <Setter TargetName="ikon" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                    <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                                    <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </StackPanel.Resources>

                        <TextBlock Margin="12,0,0,10" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SideMuted}" Text="MENU UTAMA" />
                        <ItemsControl Focusable="False" ItemTemplate="{StaticResource ItemMenu}" ItemsSource="{Binding MenuUtama}" />
                        <TextBlock Margin="12,18,0,10" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SideMuted}" Text="ADMINISTRASI" />
                        <ItemsControl Focusable="False" ItemTemplate="{StaticResource ItemMenu}" ItemsSource="{Binding MenuAdministrasi}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  ============ Area kanan ============  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Judul}" Text="{Binding Halaman.Judul}" />
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Halaman.Breadcrumb}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Grid Width="320">
                            <TextBox x:Name="KotakCari"
                                     c:Hint.Icon="{StaticResource Icon.Search}"
                                     c:Hint.Text="Cari NRP atau nama kader…"
                                     Style="{StaticResource Input}"
                                     Text="{Binding Pencarian, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding CariCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Border Margin="0,0,8,0"
                                    Padding="6,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Surface2}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    IsHitTestVisible="False">
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Muted}" Text="Ctrl K" />
                            </Border>
                        </Grid>
                        <Button Margin="12,0,0,0"
                                Command="{Binding GantiTemaCommand}"
                                Style="{StaticResource Btn.Icon.Bordered}"
                                Tag="{Binding Gelap, Converter={StaticResource PilihIkonTema}}"
                                ToolTip="Ganti tema terang/gelap" />
                        <ContentControl Width="36"
                                        Height="36"
                                        Margin="12,0,0,0"
                                        Content="{Binding NamaPengguna}"
                                        Style="{StaticResource Avatar}"
                                        ToolTip="{Binding LabelPeran}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Margin="32,24,32,28" Content="{Binding Halaman}" Focusable="False" />
            <Control Grid.Row="1" VerticalAlignment="Top" Style="{StaticResource Memuat}" Visibility="{Binding Halaman.SedangMemuat, Converter={StaticResource BoolKeVisibility}}" />

            <!--  Toast  -->
            <Border Grid.Row="1"
                    MaxWidth="520"
                    Margin="0,0,32,32"
                    Padding="16,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Brush.Side}"
                    CornerRadius="12"
                    Visibility="{Binding ToastTampil, Converter={StaticResource BoolKeVisibility}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" Opacity="0.25" ShadowDepth="6" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Icon x:Name="IkonToast" Margin="0,0,12,0" VerticalAlignment="Center" Data="{StaticResource Icon.Checkmark}" Foreground="#4ADE80" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13.5" FontWeight="Medium" Foreground="#F1F4FA" Text="{Binding ToastPesan}" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Margin="12,0,-6,0" Command="{Binding TutupToastCommand}" Foreground="#8C98B5" Style="{StaticResource Btn.Icon}" Tag="{StaticResource Icon.Close}" />
                </Grid>
            </Border>
        </Grid>

        <!--  Overlay saat dialog terbuka  -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Brush.Overlay}" Visibility="{Binding OverlayTampil, Converter={StaticResource BoolKeVisibility}}" />
    </Grid>
</Window>
